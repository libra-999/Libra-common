<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <groupId>hldev.xyz</groupId>
    <artifactId>libra-common</artifactId>
    <version>1.0.0</version>
    <name>common</name>
    <url>https://github.com/libra-999/Libra-common.git</url>

    <modules>
        <module>common-capcha</module>
        <module>common-cache</module>
        <module>common-util</module>
        <module>common-all</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.30</lombok.version>
        <springboot.version>3.3.0</springboot.version>
        <hutool-all.version>5.8.38</hutool-all.version>
        <github.pageHelper>2.1.0</github.pageHelper>
        <alibaba.fastjson>2.0.57</alibaba.fastjson>
        <common>2.18.0</common>
        <ooxml>5.2.3</ooxml>
        <jjwt>0.12.6</jjwt>
        <jaxb.api>2.3.1</jaxb.api>
        <user.agent>1.21</user.agent>
        <easyexcel.version>3.2.1</easyexcel.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool-all.version}</version>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <scm>
        <connection>scm:https://github.com/libra-999/Libra-common.git</connection>
        <developerConnection>scm:git@github.com:libra-999/Libra-common.git</developerConnection>
        <url>git@github.com:libra-999/Libra-common.git</url>
    </scm>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>libra</name>
            <email>lglibra1@gmail.com</email>
        </developer>
    </developers>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
